<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- BACK BUTTON -->
    <Button
        android:id="@+id/btnBackServices"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/techfix_surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="← BACK"
        android:textColor="@color/techfix_white"
        android:textStyle="bold" />

    <!-- TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repair Services"
        android:textColor="@color/techfix_white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- SUBTITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Choose the repair service you need"
        android:textColor="@color/techfix_text_secondary"
        android:textSize="15sp" />

    <!-- SERVICES LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerServices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>