<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@color/techfix_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDeviceName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Phone"
        android:textColor="@color/techfix_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDeviceDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Apple • iPhone 13"
        android:textColor="@color/techfix_text_secondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnBookRepair"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/techfix_gold"
        android:text="BOOK REPAIR"
        android:textColor="@color/techfix_background"
        android:textStyle="bold" />

</LinearLayout>