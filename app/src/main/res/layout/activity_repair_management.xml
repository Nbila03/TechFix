<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/techfix_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repair Management"
                android:textColor="@color/techfix_white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Monitor and manage customer repairs"
                android:textColor="@color/techfix_text_secondary"
                android:textSize="14sp" />


            <!-- SEARCH -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchRepairLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:hint="Search repair">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchRepair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/techfix_white"
                    android:textColorHint="@color/techfix_text_secondary" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- FILTERS -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="All"
                        android:textColor="@color/techfix_background"
                        android:textStyle="bold"
                        android:background="@drawable/bg_techfix_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterPending"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_marginStart="8dp"
                        android:text="Pending"
                        android:textColor="@color/techfix_gold"
                        android:textStyle="bold"
                        android:background="@drawable/bg_techfix_outline_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_marginStart="8dp"
                        android:text="In Progress"
                        android:textColor="@color/techfix_gold"
                        android:textStyle="bold"
                        android:background="@drawable/bg_techfix_outline_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_marginStart="8dp"
                        android:text="Completed"
                        android:textColor="@color/techfix_gold"
                        android:textStyle="bold"
                        android:background="@drawable/bg_techfix_outline_button" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- SECTION TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Current Repairs"
                android:textColor="@color/techfix_white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>


    <!-- DYNAMIC REPAIR LIST -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRepairs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false" />

</LinearLayout>