<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/techfix_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- BACK BUTTON -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackRepairManagement"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="← Back"
                android:textColor="@color/techfix_gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_techfix_outline_button"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <!-- HEADER -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Repair Management"
                android:textColor="@color/techfix_white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Monitor and manage customer repairs"
                android:textColor="@color/techfix_text_secondary"
                android:textSize="14sp" />

            <!-- SUMMARY CARDS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <!-- TOTAL -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_techfix_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvTotalRepairs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/techfix_gold"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textColor="@color/techfix_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- PENDING -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_techfix_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvPendingRepairs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/techfix_gold"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:textColor="@color/techfix_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- IN PROGRESS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_techfix_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvProgressRepairs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#42A5F5"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="In Progress"
                        android:textColor="@color/techfix_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- SEARCH -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchRepairLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Search by repair ID, customer or device">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchRepair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/techfix_white"
                    android:textColorHint="@color/techfix_text_secondary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- FILTER TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Filter by status"
                android:textColor="@color/techfix_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- FILTER BUTTONS -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="All"
                        android:textColor="@color/techfix_background"
                        android:textStyle="bold"
                        android:background="@drawable/bg_techfix_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterPending"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_marginStart="8dp"
                        android:text="Pending"
                        android:textColor="@color/techfix_gold"
                        android:textStyle="bold"
                        android:background="@drawable/bg_techfix_outline_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_marginStart="8dp"
                        android:text="In Progress"
                        android:textColor="@color/techfix_gold"
                        android:textStyle="bold"
                        android:background="@drawable/bg_techfix_outline_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilterCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:layout_marginStart="8dp"
                        android:text="Completed"
                        android:textColor="@color/techfix_gold"
                        android:textStyle="bold"
                        android:background="@drawable/bg_techfix_outline_button" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- SECTION HEADER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Repairs"
                        android:textColor="@color/techfix_white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Select a repair to view details"
                        android:textColor="@color/techfix_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvRepairCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 repairs"
                    android:textColor="@color/techfix_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- DYNAMIC REPAIR LIST -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRepairs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>