<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"

    app:cardBackgroundColor="@color/techfix_surface"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/techfix_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">


        <!-- ================================================= -->
        <!-- TOP SECTION -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- INITIAL CIRCLE -->

            <TextView
                android:id="@+id/tvTechnicianInitial"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_techfix_circle"
                android:gravity="center"
                android:text="T"
                android:textColor="@color/techfix_background"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- NAME + SPECIALIZATION -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">


                <!-- NAME -->

                <TextView
                    android:id="@+id/tvTechnicianName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Technician Name"
                    android:textColor="@color/techfix_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <!-- SPECIALIZATION -->

                <TextView
                    android:id="@+id/tvTechnicianSpecialization"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Vehicle Technician"
                    android:textColor="@color/techfix_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- STATUS -->

            <TextView
                android:id="@+id/tvTechnicianStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_techfix_input"
                android:paddingStart="9dp"
                android:paddingTop="5dp"
                android:paddingEnd="9dp"
                android:paddingBottom="5dp"
                android:text="AVAILABLE"
                android:textColor="@color/techfix_success"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- DIVIDER -->
        <!-- ================================================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:background="@color/techfix_border" />


        <!-- ================================================= -->
        <!-- PHONE -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Phone"
                android:textColor="@color/techfix_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTechnicianPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No phone number"
                android:textColor="@color/techfix_white"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BRANCH -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Branch"
                android:textColor="@color/techfix_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTechnicianBranch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Branch ID: 1"
                android:textColor="@color/techfix_white"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BUTTONS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- EDIT -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditTechnician"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="EDIT"
                android:textColor="@color/techfix_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_techfix_outline_button" />


            <!-- DELETE -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteTechnician"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="DELETE"
                android:textColor="@color/techfix_error"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_techfix_outline_button" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>