<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRepair"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/techfix_surface"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/techfix_border"
    app:strokeWidth="1dp">

    <!-- one single repair card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- TOP ROW -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRepairId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repair #1024"
                    android:textColor="@color/techfix_gold"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Toyota Prius"
                    android:textColor="@color/techfix_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- STATUS -->

            <TextView
                android:id="@+id/tvRepairStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_techfix_input"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="IN PROGRESS"
                android:textColor="@color/techfix_warning"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:background="@color/techfix_border" />


        <!-- SERVICE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvServiceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Full Vehicle Service"
            android:textColor="@color/techfix_white"
            android:textSize="14sp" />


        <!-- TECHNICIAN + COST -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTechnician"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Technician: Kasun Perera"
                android:textColor="@color/techfix_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvRepairCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LKR 25,000"
                android:textColor="@color/techfix_gold"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- APPOINTMENT -->

        <TextView
            android:id="@+id/tvAppointment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Appointment: 23 Aug 2026 • 10:30 AM"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>