<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- BACK -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackTechnician"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="← Back"
            android:textColor="@color/techfix_gold"
            android:textStyle="bold"
            android:background="@drawable/bg_techfix_outline_button" />

        <!-- HEADER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Add Technician"
            android:textColor="@color/techfix_white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Enter technician details"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp" />

        <!-- NAME -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:hint="Technician Name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTechnicianName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/techfix_white"
                android:textColorHint="@color/techfix_text_secondary" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- SPECIALIZATION -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Specialization">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSpecialization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/techfix_white"
                android:textColorHint="@color/techfix_text_secondary" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- PHONE -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Phone Number">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTechnicianPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:textColor="@color/techfix_white"
                android:textColorHint="@color/techfix_text_secondary" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- SAVE -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTechnician"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="25dp"
            android:text="Save Technician"
            android:textColor="@color/techfix_background"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_techfix_button" />

    </LinearLayout>

</ScrollView>