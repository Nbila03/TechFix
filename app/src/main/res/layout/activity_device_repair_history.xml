<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvDeviceHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/techfix_gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="20dp"
        android:background="@color/techfix_surface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDeviceRepairs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmptyDeviceRepairs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No repairs recorded for this device."
            android:textColor="@color/techfix_text_secondary"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>