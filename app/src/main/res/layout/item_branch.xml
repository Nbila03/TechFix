<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/techfix_surface"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/techfix_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBranchName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/techfix_white"
                android:textStyle="bold"
                android:textSize="20sp"
                tools:text="TechFix Colombo" />

            <TextView
                android:id="@+id/tvBranchStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_techfix_pill"
                android:backgroundTint="@color/techfix_surface_light"
                android:textColor="@color/techfix_success"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="OPEN" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBranchAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="16sp"
            android:layout_marginTop="6dp"
            tools:text="123 Galle Rd, Colombo" />

        <TextView
            android:id="@+id/tvBranchDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/techfix_gold"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            tools:text="4.2 km away" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>