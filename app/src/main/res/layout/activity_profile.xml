<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- PROFILE TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="My Profile"
            android:textColor="@color/techfix_white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Customer account information"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="15sp" />

        <!-- PROFILE INFORMATION CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:background="@color/techfix_surface"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- NAME LABEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="@color/techfix_text_secondary"
                android:textSize="14sp" />

            <!-- CUSTOMER NAME -->
            <TextView
                android:id="@+id/txtProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="TechFix Customer"
                android:textColor="@color/techfix_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- EMAIL LABEL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Email"
                android:textColor="@color/techfix_text_secondary"
                android:textSize="14sp" />

            <!-- CUSTOMER EMAIL -->
            <TextView
                android:id="@+id/txtProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="customer@techfix.com"
                android:textColor="@color/techfix_white"
                android:textSize="17sp" />

        </LinearLayout>

        <!-- LOGOUT BUTTON -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <!-- EMPTY SPACE PUSHES BACK BUTTON TO BOTTOM -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- BACK BUTTON -->
        <Button
            android:id="@+id/btnBackProfile"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/techfix_surface"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="← BACK"
            android:textColor="@color/techfix_white"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>