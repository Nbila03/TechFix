<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TECHFIX"
                    android:textColor="@color/techfix_gold"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Admin Dashboard"
                    android:textColor="@color/techfix_white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Welcome back, Admin"
                    android:textColor="@color/techfix_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Admin Avatar -->
            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_techfix_circle"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/techfix_background"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Overview -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Overview"
            android:textColor="@color/techfix_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- First Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- Repairs Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                app:cardBackgroundColor="@color/techfix_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/techfix_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_techfix_circle"
                        android:gravity="center"
                        android:text="R"
                        android:textColor="@color/techfix_background"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="24"
                        android:textColor="@color/techfix_white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Repairs"
                        android:textColor="@color/techfix_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Technicians Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                app:cardBackgroundColor="@color/techfix_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/techfix_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_techfix_circle"
                        android:gravity="center"
                        android:text="T"
                        android:textColor="@color/techfix_background"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="08"
                        android:textColor="@color/techfix_white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Technicians"
                        android:textColor="@color/techfix_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Second Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- Spare Parts -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                app:cardBackgroundColor="@color/techfix_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/techfix_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_techfix_circle"
                        android:gravity="center"
                        android:text="P"
                        android:textColor="@color/techfix_background"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="56"
                        android:textColor="@color/techfix_white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spare Parts"
                        android:textColor="@color/techfix_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Low Stock -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="145dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                app:cardBackgroundColor="@color/techfix_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/techfix_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_techfix_circle"
                        android:gravity="center"
                        android:text="!"
                        android:textColor="@color/techfix_background"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="04"
                        android:textColor="@color/techfix_error"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Low Stock"
                        android:textColor="@color/techfix_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Quick Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Quick Actions"
            android:textColor="@color/techfix_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Repair Management -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRepairManagement"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="Repair Management"
            android:textColor="@color/techfix_background"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_techfix_button" />

        <!-- Technician Management -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTechnicianManagement"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="Technician Management"
            android:textColor="@color/techfix_gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_techfix_outline_button" />

        <!-- Spare Parts Management -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSparePartsManagement"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="Spare Parts Management"
            android:textColor="@color/techfix_gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_techfix_outline_button" />

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>

</ScrollView>