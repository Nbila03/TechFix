<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back button -->
        <Button
            android:id="@+id/btnBackAddDevice"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← BACK"
            android:textColor="@color/techfix_white"
            android:textStyle="bold"
            android:backgroundTint="@color/techfix_surface"
            android:layout_marginBottom="12dp" />

        <!-- Page title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADD DEVICE"
            android:textColor="@color/techfix_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your device details"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp"/>

        <!-- Category -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE CATEGORY"
            android:textColor="@color/techfix_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/techfix_surface"
            android:padding="10dp"/>

        <!-- Device Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE NAME"
            android:textColor="@color/techfix_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/editDeviceName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/techfix_surface"
            android:hint="e.g. My iPhone"
            android:padding="12dp"
            android:textColor="@color/techfix_white"
            android:textColorHint="@color/techfix_text_secondary"/>

        <!-- Brand -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BRAND"
            android:textColor="@color/techfix_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/editBrand"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/techfix_surface"
            android:hint="e.g. Apple"
            android:padding="12dp"
            android:textColor="@color/techfix_white"
            android:textColorHint="@color/techfix_text_secondary"/>

        <!-- Model -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODEL"
            android:textColor="@color/techfix_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/editModel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/techfix_surface"
            android:hint="e.g. iPhone 13"
            android:padding="12dp"
            android:textColor="@color/techfix_white"
            android:textColorHint="@color/techfix_text_secondary"/>

        <!-- Serial Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERIAL NUMBER"
            android:textColor="@color/techfix_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/editSerialNumber"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/techfix_surface"
            android:hint="Optional"
            android:padding="12dp"
            android:textColor="@color/techfix_white"
            android:textColorHint="@color/techfix_text_secondary"/>

        <!-- Save -->
        <Button
            android:id="@+id/btnSaveDevice"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:text="SAVE DEVICE"
            android:textColor="@color/techfix_background"
            android:textStyle="bold"
            android:backgroundTint="@color/techfix_gold"/>

    </LinearLayout>

</ScrollView>
