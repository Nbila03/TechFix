<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ===================================================== -->
        <!-- BACK BUTTON -->
        <!-- ===================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackTechnicianManagement"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="← Back"
            android:textColor="@color/techfix_gold"
            android:textStyle="bold"
            android:background="@drawable/bg_techfix_outline_button" />


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Technician Management"
            android:textColor="@color/techfix_white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Manage technicians and repair assignments"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp" />


        <!-- ===================================================== -->
        <!-- SUMMARY CARDS -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <!-- TOTAL TECHNICIANS -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@color/techfix_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/techfix_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <TextView
                        android:id="@+id/tvTotalTechnicians"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/techfix_gold"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Total Technicians"
                        android:textColor="@color/techfix_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- AVAILABLE -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/techfix_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/techfix_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <TextView
                        android:id="@+id/tvAvailableTechnicians"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/techfix_success"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Available"
                        android:textColor="@color/techfix_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- SEARCH -->
        <!-- ===================================================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchTechnicianLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Search technician">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchTechnician"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/techfix_white"
                android:textColorHint="@color/techfix_text_secondary" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ===================================================== -->
        <!-- ADD TECHNICIAN -->
        <!-- ===================================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddTechnician"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_techfix_button"
            android:text="+  Add Technician"
            android:textColor="@color/techfix_background"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- ===================================================== -->
        <!-- SECTION TITLE -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Technicians"
            android:textColor="@color/techfix_white"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- ===================================================== -->
        <!-- DYNAMIC TECHNICIAN LIST -->
        <!-- ===================================================== -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTechnicians"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingBottom="20dp" />

    </LinearLayout>

</ScrollView>